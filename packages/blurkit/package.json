{
  "name": "blurkit",
  "version": "0.1.9",
  "license": "MIT",
  "type": "module",
  "bin": {
    "blurkit": "dist/cli.cjs"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/root-node.d.ts",
  "typesVersions": {
    "*": {
      "deno": ["./dist/deno.d.ts"],
      "node": ["./dist/node.d.ts"],
      "browser": ["./dist/browser.d.ts"],
      "edge": ["./dist/edge.d.ts"],
      "cloudflare": ["./dist/cloudflare.d.ts"],
      "wasm": ["./dist/wasm.d.ts"],
      "*": ["./dist/root-node.d.ts"]
    }
  },
  "exports": {
    ".": {
      "deno": {
        "import": {
          "types": "./dist/root-deno.d.ts",
          "default": "./dist/root-deno.js"
        },
        "require": {
          "types": "./dist/root-deno.d.cts",
          "default": "./dist/root-deno.cjs"
        }
      },
      "browser": {
        "import": {
          "types": "./dist/root-browser.d.ts",
          "default": "./dist/root-browser.js"
        },
        "require": {
          "types": "./dist/root-browser.d.cts",
          "default": "./dist/root-browser.cjs"
        }
      },
      "worker": {
        "import": {
          "types": "./dist/root-edge.d.ts",
          "default": "./dist/root-edge.js"
        },
        "require": {
          "types": "./dist/root-edge.d.cts",
          "default": "./dist/root-edge.cjs"
        }
      },
      "node": {
        "import": {
          "types": "./dist/root-node.d.ts",
          "default": "./dist/root-node.js"
        },
        "require": {
          "types": "./dist/root-node.d.cts",
          "default": "./dist/root-node.cjs"
        }
      },
      "default": {
        "import": {
          "types": "./dist/root-edge.d.ts",
          "default": "./dist/root-edge.js"
        },
        "require": {
          "types": "./dist/root-edge.d.cts",
          "default": "./dist/root-edge.cjs"
        }
      }
    },
    "./deno": {
      "import": {
        "types": "./dist/deno.d.ts",
        "default": "./dist/deno.js"
      },
      "require": {
        "types": "./dist/deno.d.cts",
        "default": "./dist/deno.cjs"
      }
    },
    "./node": {
      "import": {
        "types": "./dist/node.d.ts",
        "default": "./dist/node.js"
      },
      "require": {
        "types": "./dist/node.d.cts",
        "default": "./dist/node.cjs"
      }
    },
    "./browser": {
      "import": {
        "types": "./dist/browser.d.ts",
        "default": "./dist/browser.js"
      },
      "require": {
        "types": "./dist/browser.d.cts",
        "default": "./dist/browser.cjs"
      }
    },
    "./edge": {
      "import": {
        "types": "./dist/edge.d.ts",
        "default": "./dist/edge.js"
      },
      "require": {
        "types": "./dist/edge.d.cts",
        "default": "./dist/edge.cjs"
      }
    },
    "./cloudflare": {
      "import": {
        "types": "./dist/cloudflare.d.ts",
        "default": "./dist/cloudflare.js"
      },
      "require": {
        "types": "./dist/cloudflare.d.cts",
        "default": "./dist/cloudflare.cjs"
      }
    },
    "./wasm": {
      "import": {
        "types": "./dist/wasm.d.ts",
        "default": "./dist/wasm.js"
      },
      "require": {
        "types": "./dist/wasm.d.cts",
        "default": "./dist/wasm.cjs"
      }
    }
  },
  "files": [
    "dist/*.js",
    "dist/*.cjs",
    "dist/*.d.ts",
    "dist/*.d.cts"
  ],
  "description": "Universal image placeholder generation for Node, Bun, Deno, browser, and edge runtimes.",
  "keywords": [
    "placeholder",
    "blurhash",
    "thumbhash",
    "image",
    "blur",
    "blur-up",
    "lazy-loading",
    "image-optimization",
    "node",
    "deno",
    "browser",
    "edge",
    "cloudflare",
    "wasm",
    "cli"
  ],
  "homepage": "https://blurkit.okazakee.dev",
  "bugs": {
    "url": "https://github.com/Okazakee/blurkit/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Okazakee/blurkit.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "check": "tsc --noEmit",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "blurhash": "^2.0.5",
    "commander": "^14.0.3",
    "fast-glob": "^3.3.3",
    "thumbhash": "^0.1.1"
  },
  "optionalDependencies": {
    "sharp": ">=0.34.5 <0.36.0"
  },
  "devDependencies": {
    "blurkit-wasm-codecs": "workspace:*",
    "sharp": "^0.34.5"
  },
  "peerDependencies": {
    "blurkit-wasm-codecs": "^0.1.9",
    "sharp": ">=0.34.5 <0.36.0"
  },
  "peerDependenciesMeta": {
    "blurkit-wasm-codecs": {
      "optional": true
    },
    "sharp": {
      "optional": true
    }
  }
}
