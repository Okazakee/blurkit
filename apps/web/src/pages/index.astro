---
import '../styles/site.css'
import { BlurDemo } from '../components/BlurDemo'
import { SignalBand } from '../components/SignalBand'
import { HeroArt } from '../components/HeroArt'
import { BLURKIT_NPM_VERSION_URL, BLURKIT_VERSION } from '../utils/blurkit-version'

const fallbackSiteUrl = new URL('https://blurkit.okazakee.dev/')
const siteBase = Astro.site ?? fallbackSiteUrl
const siteUrl = siteBase.origin
const title = 'blurkit - Universal Placeholder Generation'
const description =
  'Generate BlurHash and ThumbHash placeholders across Node, Deno, browser, edge, Cloudflare, and WASM runtimes.'
const canonicalUrl = new URL('/', siteBase).toString()
const socialImage = new URL('/social-card.png', siteBase).toString()
const socialImageAlt = 'blurkit social card with product title and runtime coverage'
const installCommand = 'pnpm add blurkit sharp'
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'blurkit',
  url: siteUrl,
  description,
  inLanguage: 'en',
  potentialAction: {
    '@type': 'SearchAction',
    target: `${siteUrl}/docs/?q={search_term_string}`,
    'query-input': 'required name=search_term_string',
  },
}

const features = [
  {
    title: 'Runtime entrypoints',
    body: 'Import the runtime you actually run on. No conditional shims, no guessing which decode path fired.',
    tags: ['node', 'deno', 'browser', 'edge', 'cloudflare', 'wasm'],
  },
  {
    title: 'Two algorithms',
    body: 'BlurHash for a tunable gradient, ThumbHash when the payload has to stay tiny. Same call, one flag.',
    tags: ['blurhash', 'thumbhash'],
  },
  {
    title: 'A finished result',
    body: 'Every encode returns a data URL, the raw hash, placeholder dimensions, and the source metadata behind it.',
    tags: ['dataURL', 'hash', 'meta'],
  },
  {
    title: 'Batch encoding',
    body: 'encodeMany() for one job with many images, encodeManySettled() when a single bad file must not sink the run.',
    tags: ['encodeMany', 'settled'],
  },
  {
    title: 'CLI and manifests',
    body: 'Single-image JSON from the terminal, or folder manifests wired straight into a build and a CMS import.',
    tags: ['blurkit encode', 'manifest'],
  },
  {
    title: 'Cache helpers',
    body: 'Memory and filesystem helpers for Node, worker cache support on Cloudflare. Encode once, reuse everywhere.',
    tags: ['memory', 'filesystem', 'worker'],
  },
]

const runtimes = [
  { name: 'Node', entry: 'blurkit/node', decode: 'sharp', needs: 'sharp' },
  { name: 'Deno', entry: 'blurkit/deno', decode: 'wasm', needs: 'wasm-codecs' },
  { name: 'Browser', entry: 'blurkit/browser', decode: 'canvas', needs: 'none' },
  { name: 'Edge', entry: 'blurkit/edge', decode: 'native + wasm', needs: 'wasm-codecs' },
  { name: 'Cloudflare', entry: 'blurkit/cloudflare', decode: 'cf.image', needs: 'none' },
  { name: 'WASM', entry: 'blurkit/wasm', decode: 'wasm', needs: 'wasm-codecs' },
]
---

<html lang="en" dir="ltr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0a0a0b" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Geist:wght@300..700&family=Geist+Mono:wght@400;500;600&display=swap"
    />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content="blurkit" />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:alt" content={socialImageAlt} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:type" content="image/png" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <meta name="twitter:image:alt" content={socialImageAlt} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(structuredData)} />
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to main content</a>

    <div class="shell">
      <header class="bar">
        <div class="bar__in">
          <a class="brand" href="/">
            <img class="brand__mark" src="/favicon.svg" alt="" width="34" height="34" />
            <span class="brand__name">blurkit<i>.</i></span>
          </a>

          <nav class="bar__nav" aria-label="Primary">
            <a href="#features">Features</a>
            <a href="#runtimes">Runtimes</a>
            <a href="#live-demo">Live demo</a>
            <a href="/docs/">Docs</a>
            <a href="/docs/api/encode/">API</a>
          </nav>

          <div class="bar__tools">
            <a class="pill" href={BLURKIT_NPM_VERSION_URL}>v{BLURKIT_VERSION}</a>
            <a class="pill pill--solid" href="https://github.com/okazakee/blurkit">
              GitHub <span aria-hidden="true">↗</span>
            </a>
          </div>
        </div>
      </header>

      <main class="main" id="main-content">
        <section class="hero" id="top">
          <div class="hero__in">
            <div class="hero__copy">
              <p class="kicker">
                <span class="kicker__n">v{BLURKIT_VERSION}</span>
                <span>universal placeholder generation</span>
                <span class="kicker__sep" aria-hidden="true">/</span>
                <span>MIT</span>
              </p>

              <h1 class="hero__title">
                Image in.<br />
                <em>Placeholder</em> out.
              </h1>

              <p class="hero__lede">
                blurkit turns any image into a <strong>BlurHash</strong> or <strong>ThumbHash</strong> data URL across
                Node, Deno, browser, edge, Cloudflare, and WASM. One encode call, six runtimes, no ceremony.
              </p>

              <div class="hero__actions">
                <a class="btn btn--accent" href="#live-demo">Run the live demo <span aria-hidden="true">↓</span></a>
                <a class="btn" href="/docs/quick-start/">Quick start</a>
              </div>

              <div class="install">
                <span class="install__prompt" aria-hidden="true">$</span>
                <code>{installCommand}</code>
                <button class="copy" type="button" data-copy={installCommand}>copy</button>
              </div>

              <dl class="hero__stats">
                <div><dt>runtimes</dt><dd>06</dd></div>
                <div><dt>algorithms</dt><dd>02</dd></div>
                <div><dt>optional deps</dt><dd>01</dd></div>
                <div><dt>config</dt><dd>00</dd></div>
              </dl>
            </div>

            <div class="hero__art">
              <HeroArt client:idle />
            </div>
          </div>
        </section>

        <div class="band" aria-hidden="true">
          <SignalBand client:idle />
        </div>

        <section class="sec" id="features">
          <div class="sec__head">
            <h2 class="sec__title">Everything between <em>file</em> and <em>first paint</em>.</h2>
            <p class="sec__lede">
              Decode, downscale, hash and render sit behind one call. The rest is tooling for builds, batches, and
              caches that survive a cold start.
            </p>
          </div>

          <div class="cards">
            {
              features.map((feature) => (
                <article class="card">
                  <h3>{feature.title}</h3>
                  <p>{feature.body}</p>
                  <ul class="tags">
                    {feature.tags.map((tag) => (
                      <li>{tag}</li>
                    ))}
                  </ul>
                </article>
              ))
            }
          </div>
        </section>

        <section class="sec" id="runtimes">
          <div class="sec__head">
            <h2 class="sec__title">The runtime <em>matrix</em>.</h2>
            <p class="sec__lede">
              Each entrypoint picks its own decode path. Use the native one when the runtime has it, the wasm codecs
              when it does not.
            </p>
          </div>

          <div class="matrix">
            <div class="matrix__row matrix__row--head" aria-hidden="true">
              <span>runtime</span>
              <span>import</span>
              <span>decode</span>
              <span>install</span>
            </div>
            {
              runtimes.map((runtime, index) => (
                <a class="matrix__row" href={`/docs/runtimes/${runtime.name.toLowerCase()}/`}>
                  <span class="matrix__name">
                    <span class="matrix__n" aria-hidden="true">
                      {String(index + 1).padStart(2, '0')}
                    </span>
                    {runtime.name}
                  </span>
                  <code>{runtime.entry}</code>
                  <span class="matrix__cell">{runtime.decode}</span>
                  <span class="matrix__cell matrix__cell--need">{runtime.needs}</span>
                </a>
              ))
            }
          </div>

          <p class="matrix__foot">
            <span aria-hidden="true">▚</span>
            Every entrypoint ships <code>encode()</code>, <code>encodeMany()</code>, and <code>encodeManySettled()</code>.
            <a href="/docs/">Compare runtimes in the docs <span aria-hidden="true">→</span></a>
          </p>
        </section>

        <section class="sec" id="live-demo">
          <div class="sec__head">
            <h2 class="sec__title">Test it <em>here</em>.</h2>
            <p class="sec__lede">
              The demo runs the browser runtime on your machine. Drop an image, move the sliders, read the exact payload
              you would ship.
            </p>
          </div>

          <BlurDemo client:idle />
        </section>
      </main>

      <footer class="foot">
        <div class="foot__in">
          <div class="foot__brand">
            <span class="foot__word">blurkit<i>.</i></span>
            <p>Runtime-aware placeholder generation, kept small and boring on purpose.</p>
            <a class="foot__link" href="https://github.com/okazakee/blurkit">github.com/okazakee/blurkit</a>
          </div>

          <nav class="foot__col" aria-label="Documentation">
            <h2>Docs</h2>
            <a href="/docs/">Overview</a>
            <a href="/docs/installation/">Installation</a>
            <a href="/docs/quick-start/">Quick start</a>
            <a href="/docs/cli/">CLI</a>
            <a href="/docs/limits/">Limits</a>
          </nav>

          <nav class="foot__col" aria-label="Runtimes">
            <h2>Runtimes</h2>
            <a href="/docs/runtimes/node/">Node</a>
            <a href="/docs/runtimes/deno/">Deno</a>
            <a href="/docs/runtimes/browser/">Browser</a>
            <a href="/docs/runtimes/edge/">Edge</a>
            <a href="/docs/runtimes/cloudflare/">Cloudflare</a>
            <a href="/docs/runtimes/wasm/">WASM</a>
          </nav>

          <nav class="foot__col" aria-label="Elsewhere">
            <h2>Elsewhere</h2>
            <a href="https://github.com/okazakee/blurkit">GitHub</a>
            <a href="https://www.npmjs.com/package/blurkit">npm</a>
            <a href={BLURKIT_NPM_VERSION_URL}>v{BLURKIT_VERSION}</a>
            <a href="https://github.com/okazakee/blurkit/blob/main/LICENSE">MIT license</a>
          </nav>
        </div>

        <div class="foot__base">
          <span>© {new Date().getFullYear()} blurkit</span>
          <span class="foot__dots" aria-hidden="true"></span>
          <span>six runtimes, one API</span>
        </div>
      </footer>
    </div>

    <script is:inline>
      document.querySelectorAll('[data-copy]').forEach((button) => {
        button.addEventListener('click', async () => {
          const value = button.getAttribute('data-copy') ?? ''
          try {
            await navigator.clipboard.writeText(value)
            button.textContent = 'copied'
            button.classList.add('is-copied')
          } catch {
            button.textContent = 'failed'
          }
          window.setTimeout(() => {
            button.textContent = 'copy'
            button.classList.remove('is-copied')
          }, 1600)
        })
      })
    </script>
  </body>
</html>
