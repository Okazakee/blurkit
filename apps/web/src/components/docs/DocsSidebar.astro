---
import navigation from '../../docs/navigation.json'
import { hrefFor } from '../../docs/nav'

const { pathname } = Astro.url
const current = pathname.replace(/\/+$/, '/')
---

<aside class="docs-sidebar" id="docs-sidebar">
  <div class="docs-sidebar__head">
    <a class="brand" href="/">
      <img class="brand__mark" src="/favicon.svg" alt="" width="30" height="30" />
      <span class="brand__name">blurkit<i>.</i></span>
    </a>
    <button class="docs-sidebar__close" type="button" data-docs-close aria-label="Close navigation">✕</button>
  </div>

  <div class="docs-sidebar__inner">
    <a class="docs-sidebar__back" href="/">← blurkit.dev</a>

    {
      navigation.map((group) => (
        <nav class="docs-group" aria-label={group.label}>
          <p class="docs-group__label">{group.label}</p>
          <ul>
            {group.items.map((item) => {
              const href = hrefFor(item.slug)
              const isCurrent = href === current || (href !== '/docs/' && current.startsWith(href))
              return (
                <li>
                  <a href={href} aria-current={isCurrent ? 'page' : undefined}>
                    {item.label}
                  </a>
                </li>
              )
            })}
          </ul>
        </nav>
      ))
    }

    <div class="docs-sidebar__foot">
      <a href="/">Home</a>
      <a href="https://github.com/okazakee/blurkit">GitHub</a>
      <a href="https://www.npmjs.com/package/blurkit">npm</a>
    </div>
  </div>
</aside>

<button class="docs-scrim" type="button" data-docs-scrim aria-label="Close documentation navigation" tabindex="-1"></button>
